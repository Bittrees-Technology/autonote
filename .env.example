APP_URL=http://127.0.0.1:3050
DATABASE_URL=postgresql://autonote:local-autonote-only@127.0.0.1:55450/autonote
AUTH_SECRET=replace-with-at-least-32-random-characters
RESEND_API_KEY=
EMAIL_FROM=
DEV_EMAIL_CONSOLE=true
S3_ENDPOINT=http://127.0.0.1:9050
S3_REGION=us-east-1
S3_BUCKET=autonote
S3_ACCESS_KEY_ID=autonote
S3_SECRET_ACCESS_KEY=local-autonote-storage-only
S3_FORCE_PATH_STYLE=true
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_DOWNLOAD_ROOT=/models
# Chat-completions-compatible hosted or local endpoint, explicit opt-in.
NOTES_BASE_URL=
NOTES_API_KEY=
NOTES_MODEL=
# Use json_object only for endpoints without strict JSON schema support.
NOTES_FORMAT=json_schema
# Optional pyannote speaker pipeline; see worker README before enabling.
DIARIZATION_MODEL=
HF_TOKEN=

# Optional integrations; separate Google OAuth clients for preview and production.
CRM_URL=https://crm.bittrees.org
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Vercel defaults to demo. Set live only after operational launch gates pass.
# AUTONOTE_MODE=demo

# Device mode needs no S3/worker/notes provider. Hosted free beta uses device.
PROCESSING_MODE=server
# Required for authenticated daily housekeeping on Vercel.
CRON_SECRET=
