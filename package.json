{
  "name": "@bittrees/autonote",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24 <26"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3050",
    "build": "next build",
    "start": "next start --port 3050",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx --env-file=.env.local scripts/migrate.ts",
    "test": "tsx --env-file=.env.test --test tests/*.test.ts",
    "format": "prettier --write app lib scripts tests"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/s3-request-presigner": "^3.0.0",
    "@huggingface/transformers": "3.8.1",
    "ethers": "^6.16.0",
    "lucide-react": "^0.577.0",
    "next": "16.3.4",
    "pg": "^8.16.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "siwe": "3.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/pg": "^8.16.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "^3.9.6",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@huggingface/transformers": {
      "sharp": "^0.35.4"
    }
  }
}
